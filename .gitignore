```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Dependencies
venv/
.venv/
.env
.env.local
*.env.*

# Debug and temporary files
*.tmp
*.log

# Development tools
.vscode/
.idea/

# Coverage reports
coverage/
htmlcov/
.coverage

# JSON database files (if they contain runtime data)
memory_db.json
debug_session.json
```